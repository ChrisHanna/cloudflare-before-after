    if (u.pathname === '/facts') return Response.json({ running: this.running, stops: this.stops, started: op?.started ?? false, settled: op?.settled ?? false, finished: op?.finished ?? false, cancelled: op?.cancelled ?? 0, status: op?.status ?? null, sdkInflight: this.inner.inflightRequests, sdkExpired: this.inner.isActivityExpired() });
