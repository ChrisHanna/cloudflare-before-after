    const root = this.env.INGEST_ROOT_SECRET; const identity = { producerId: reservation.producerId, role: reservation.role, scenarioId: reservation.scenarioId, runId: reservation.runId, releaseDigest: reservation.releaseDigest };
    const authorization = `Bearer ${await deriveIngestSecret(identity, root)}`;
