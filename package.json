{
  "name": "cloudflare-before-after",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=22.12.0 <23 || >=24.0.0" },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "lab": "tsc -p tsconfig.build.json && node dist/packages/demo-core/src/lab-cli.js",
    "demo": "tsc -p tsconfig.build.json && node dist/packages/demo-core/src/demo-cli.js",
    "build": "tsc -p tsconfig.build.json && vite build apps/command-center",
    "typecheck": "tsc --noEmit && tsc -p apps/storefront-worker/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:golden-path": "node scripts/golden-path.mjs",
    "ci:offline": "node scripts/offline-gates.mjs",
    "validate:tools": "node scripts/offline-gates.mjs --tools",
    "test:acceptance": "vitest run tests/t38-at11-14-*.test.ts tests/t39-at15-capability-*.test.ts --maxWorkers=1",
    "example:config": "tsc -p tsconfig.build.json && node dist/packages/demo-core/src/example-config.js",
    "verify:live": "node scripts/golden-path.mjs --live",
    "command-center": "pnpm build && node dist/apps/control-server/src/server.js",
    "control-server": "tsc -p tsconfig.build.json && node dist/apps/control-server/src/server.js"
  },
  "dependencies": {
    "hono": "4.13.16",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
